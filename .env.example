# MySQL (required) — pick ONE style:

# A) Discrete vars (recommended on Hostinger — avoids "Invalid URL" on mysql://)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=u391320881_mysql
# DB_PASSWORD=Yatranexus123
# DB_NAME=u391320881_yatranexus

# B) URL style (fine locally; encode @ in password as %40 if present)
# Local: DATABASE_URL=mysql://root:root@127.0.0.1:3306/yatranexus
# Hostinger: DATABASE_URL=mysql://u391320881_mysql:Yatranexus123@127.0.0.1:3306/u391320881_yatranexus
DATABASE_URL=mysql://user:password@127.0.0.1:3306/yatranexus

# Admin JWT session (required — min 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ADMIN_COOKIE_NAME=yn_admin_session

# Optional — first admin bootstrap (scripts/setup-admin-user.mjs)
# ADMIN_EMAIL=superadmin@yatranexus.com
# ADMIN_PASSWORD=
# ADMIN_FULL_NAME=Admin

# Optional — inquiry email notifications (Resend)
# RESEND_API_KEY=
# EMAIL_FROM="YatraNexus <noreply@yatranexus.com>"

# Optional — inquiry email notifications (SMTP / Zoho / Hostinger)
# SMTP_HOST=smtp.zoho.in
# SMTP_PORT=465
# SMTP_USER=info@yatranexus.com
# SMTP_PASSWORD=
# SMTP_SECURE=true

# Canonical public site URL (sitemap, Open Graph, password reset links)
# SITE_URL=https://yatranexus.com

# Optional — reCAPTCHA (fail-closed in production when both are set)
# RECAPTCHA_SECRET_KEY=
# VITE_RECAPTCHA_SITE_KEY=

# Optional — bulk image generation scripts only
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GEMINI_PROJECT_ID=
