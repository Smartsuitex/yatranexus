# Supabase (public / client-safe)
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never prefix with VITE_
# Required to read SMTP/Resend secrets from Admin → Email settings
# SUPABASE_SERVICE_ROLE_KEY=

# Optional — inquiry email notifications (Resend)
# RESEND_API_KEY=
# EMAIL_FROM="YatraNexus <noreply@yatranexus.com>"
# ADMIN_EMAIL="info@yatranexus.com"

# Optional — inquiry email notifications (SMTP / Zoho / Hostinger)
# SMTP_HOST=smtp.zoho.in
# SMTP_PORT=465
# SMTP_USER=info@yatranexus.com
# SMTP_PASSWORD=
# SMTP_SECURE=true

# Optional — reCAPTCHA (fail-closed in production when both are set, or NODE_ENV=production)
# RECAPTCHA_SECRET_KEY=
# VITE_RECAPTCHA_SITE_KEY=

# Optional — bulk image generation scripts only
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GEMINI_PROJECT_ID=
